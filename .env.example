# MangaRec AI - Root Environment Reference
# Each service maintains its own .env file for local development:
# - ai-service/.env.example -> ai-service/.env
# - be-service/.env.example -> be-service/.env
# - fe-service/.env.example -> fe-service/.env

# Global Network
COMPOSE_PROJECT_NAME=mangarec

# Port Mapping Reference (Defaults)
FE_PORT=3000
BE_PORT=8080
AI_PORT=8000
QDRANT_PORT=6333
POSTGRES_PORT=5432
REDIS_PORT=6379
