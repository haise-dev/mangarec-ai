# Groq & LLM [cite: 116]
GROQ_API_KEY=your_groq_key_here

# Qdrant Database (Local via Docker Compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_URL=your_remote_url_if_any
# QDRANT_API_KEY=your_api_key_if_any

# SQLite Database (local metadata store for AI Service)
DATABASE_URL=sqlite:////app/data/manga_metadata.db

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=mangarec_ai_service
