# MangaRec AI - AI Service Environment Variables

# LLM Provider (Required)
# Get key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Vector Database (Qdrant)
# Use "qdrant" for Docker container network, or "localhost" when running service natively
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional remote Qdrant Cloud settings:
# QDRANT_URL=https://your-cluster.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# SQLite Metadata Database
# In Docker container: sqlite:////app/data/manga_metadata.db
# Local native run: sqlite:///./data/manga_metadata.db
DATABASE_URL=sqlite:///./data/manga_metadata.db

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=mangarec_ai_service
