# MangaRec AI - Backend Service Environment Variables

# Server Configuration
BE_PORT=8080
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL Configuration
POSTGRES_DB=mangarec
POSTGRES_USER=mangarec
POSTGRES_PASSWORD=mangarec_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mangarec?currentSchema=mangarec
SPRING_DATASOURCE_USERNAME=mangarec
SPRING_DATASOURCE_PASSWORD=mangarec_password
SPRING_FLYWAY_ENABLED=true

# Redis Configuration (Rate Limiting & Token Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth 2.0 (Client ID for JWT Verification)
GOOGLE_AUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email SMTP Configuration (Gmail App Password for OTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
EMAIL_VERIFICATION_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10

# payOS Payment Gateway Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:8080/api/v1/payments/payos/webhook
PAYOS_PAYMENT_EXPIRY_MINUTES=15
